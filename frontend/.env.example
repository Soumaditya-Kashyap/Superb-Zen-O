# Superb Frontend Environment Variables
# Copy this file to .env and fill in your values

# CloudFront Base URL for HLS Streaming
# This is your CloudFront distribution domain
VITE_CLOUDFRONT_BASE_URL=https://your-cloudfront-id.cloudfront.net

# Movie HLS Paths (optional - you can also configure in src/config/movieStreams.js)
# VITE_MOVIE_ROIROIBINALE_PATH=/movie-hls1/master.m3u8

# YouTube API Key for search functionality
# Get your API key from Google Cloud Console and set it here
